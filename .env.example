# Copy to .env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────────────────────────
# JWT signing key, at least 32 characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login. Either a single user...
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
AUTH_USER_EMAIL=you@example.com
# Keep the single quotes: bcrypt hashes contain $ signs.
AUTH_USER_PASSWORD_HASH=''

# ...or several users as JSON (takes precedence when set):
# AUTH_USERS_JSON='{"you@example.com":"<bcrypt-hash>"}'

# ── Local LLM (LM Studio or any OpenAI-compatible server) ────────────────────
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_MODEL=qwen2.5-14b-instruct

# ── Optional ─────────────────────────────────────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# AUTH_REFRESH_COOKIE_SECURE=false
# AUTH_REFRESH_COOKIE_SAMESITE=lax
# AUTOLYZE_CORS_ORIGINS=
# AUTOLYZE_TRUST_PROXY_HEADERS=false
# AUTOLYZE_MAX_UPLOAD_BYTES=0
# AUTOLYZE_LARGE_CSV_MB=300
# AUTOLYZE_SPARK_MIN_ROWS=1000000
# AUTOLYZE_ML_MAX_ROWS=500000
# AUTOLYZE_SPARK_MASTER=
# JAVA_HOME=
